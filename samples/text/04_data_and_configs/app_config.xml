<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <RenderingEngine>
    <TargetDpi>96.0</TargetDpi>
    <AntialiasingMode>PerPrimitive</AntialiasingMode>
    <DirectWriteFontFamily>Cascadia Code</DirectWriteFontFamily>
    <FallbackFontFamily>Consolas</FallbackFontFamily>
    <HardwareAcceleration>true</HardwareAcceleration>
  </RenderingEngine>
  <EditorSettings>
    <DefaultTabSpaces>4</DefaultTabSpaces>
    <WordWrapEnabled>true</WordWrapEnabled>
    <AutoIndentEnabled>true</AutoIndentEnabled>
    <CaretBlinkCycleMs>500</CaretBlinkCycleMs>
    <MaxUndoStackLevels>100</MaxUndoStackLevels>
  </EditorSettings>
</Configuration>
