#include <windows.h>
#include "version.h"

101 ICON "app.ico"
102 RCDATA "app_logo.png"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     WINPREVIEW_VERSION_MAJOR,WINPREVIEW_VERSION_MINOR,WINPREVIEW_VERSION_PATCH,WINPREVIEW_VERSION_BUILD
PRODUCTVERSION  WINPREVIEW_VERSION_MAJOR,WINPREVIEW_VERSION_MINOR,WINPREVIEW_VERSION_PATCH,WINPREVIEW_VERSION_BUILD
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Code-Xceed"
            VALUE "FileDescription",  "WinPreview - Ultra-Fast Spacebar Quick Look for Windows"
            VALUE "FileVersion",      WINPREVIEW_VERSION_STR
            VALUE "InternalName",     "WinPreview"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Code-Xceed. All rights reserved."
            VALUE "OriginalFilename", "WinPreview.exe"
            VALUE "ProductName",      "WinPreview"
            VALUE "ProductVersion",   WINPREVIEW_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
